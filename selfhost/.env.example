# Required. RustFS (S3-compatible object store) credentials used for the
# rustfs service, the bucket-init task, and the bucket the API reads/writes.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Optional. Defaults to "tandra". Used as the Mongo database name and
# as the RustFS bucket. The bucket-init container creates it on first run.
DATABASE_NAME=tandra
BUCKET_NAME=tandra

# Host port the web container publishes on. Maps to the web container's
# internal port 3000 (nginx). Set to e.g. 8080 if 4000 is taken.
WEB_PORT=4000

# Optional. A Gemini API key from https://aistudio.google.com/apikey. Leave unset
# to disable the text AI features (recipe import via URL, tagging, substitute
# suggestions, item aisles, voice add). Without it, those endpoints answer
# 503 ai_disabled and the UI hides them.
GEMINI_API_KEY=
# Optional. Override the Gemini model (default gemini-3.5-flash-lite).
RECIPE_IMPORT_LLM_MODEL=
# Optional. A Fal.ai API key from https://fal.ai/dashboard/keys. Leave unset
# to disable AI image generation.
FAL_KEY=
FAL_MODEL=
FAL_RECIPE_MODEL=

# Wikibooks asks every consumer for a User-Agent. Override with your own
# contact so any abuse reports reach you rather than the project default.
WIKIBOOKS_USER_AGENT=Tandra/1.0 (https://github.com/igor-siergiej/tandra)

# Sign-in (Better Auth). Required. Generate the secret with `openssl rand -base64 32`; it must
# stay stable or every signed-in session is invalidated. `BETTER_AUTH_URL` is the public origin
# the browser sees for the web app (api is same-origin under /api).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Optional: enables Google sign-in (jott #146). Set both to enable; leave both empty to
# keep username/password only. Add `https://<your-host>/api/auth/callback/google` to your
# Google Cloud OAuth client's authorised redirect URIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Analytics is off by default: the image ships an empty /config.json, so the
# web app never loads a tracker. To use your own Umami (v3, with
# TRACKER_SCRIPT_NAME=p.js), mount a config.json into the web service at
# /usr/share/nginx/html/config.json:
#   { "analytics": { "host": "https://<umami-host>", "websiteId": "<id>", "enabled": true } }
# The app loads `<host>/p.js`. Serve it from the app's own origin (a reverse
# proxy path, like Tandra's /pulse) so the CSP needs no change; a different
# origin must be added to script-src in packages/web/nginx.conf.
