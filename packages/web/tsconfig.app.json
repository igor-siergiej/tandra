{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["vite/client", "vite-plus/test/globals", "node"],
    "paths": {
      "@tandra/types": ["../types/src"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite-env.d.ts", "global.d.ts", "vitest-matchers.d.ts"],
  "references": [{ "path": "../types" }]
}
