{
  "name": "@tandra/api",
  "version": "2.6.3",
  "scripts": {
    "start": "bun --watch src/index.ts",
    "start:e2e": "bun src/index.ts",
    "build": "rm -rf build && mkdir -p build && cp -R src/. build/ && find build -name '*.test.ts' -delete && rm -f build/test-setup.ts",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:run": "bun test --isolate",
    "reindex": "bun scripts/reindex-discovery.ts",
    "ingest": "bun scripts/ingest-wikibooks.ts",
    "validate-library": "bun scripts/validate-discovery-library.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.12",
    "@imapps/api-utils": "0.6.0",
    "@opensearch-project/opensearch": "^3.9.0",
    "@tandra/types": "workspace:*",
    "better-auth": "1.7.12",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.2",
    "hono": "^4.6.14",
    "mongodb": "^7.2.0",
    "parse-ingredient": "^2.2.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.2"
  }
}
