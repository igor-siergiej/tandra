FROM oven/bun:1-alpine AS builder

ARG APP_VERSION
ENV APP_VERSION=$APP_VERSION

WORKDIR /app

ARG NODE_AUTH_TOKEN

COPY package.json bun.lock .bunfig.toml ./
# bun install applies package.json's patchedDependencies from here and fails without it.
COPY patches patches/
COPY packages packages/

RUN NODE_AUTH_TOKEN=${NODE_AUTH_TOKEN} bun install --frozen-lockfile

COPY . .

RUN APP_VERSION="$APP_VERSION" bun run --filter @tandra/web build

FROM nginx:alpine

# Single source of truth: the same nginx.conf checked in for the dev-mirror
# and the e2e specs (packages/web/nginx.conf). Avoids the old heredoc
# drift — every nginx rule change here is reflected in prod without a
# separate edit.
RUN rm /etc/nginx/conf.d/default.conf
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/packages/web/build /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
