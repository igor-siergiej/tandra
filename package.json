{
  "name": "tandra",
  "version": "2.6.3",
  "private": true,
  "repository": "https://github.com/igor-siergiej/tandra",
  "author": "Igor Siergiej <igorsiergiej@gmail.com>",
  "scripts": {
    "start:web": "bun run --filter @tandra/web start",
    "start:api": "dotenv -e .env -- bun run --filter @tandra/api start",
    "reindex:discovery": "dotenv -e .env -- bun run --filter @tandra/api reindex",
    "discover:ingest": "dotenv -e .env -- bun run --filter @tandra/api ingest",
    "discover:validate": "dotenv -e .env -- bun run --filter @tandra/api validate-library",
    "auth:reset-password": "dotenv -e .env -- bun packages/api/scripts/auth/reset-password.ts",
    "start": "bun run start:web & bun run start:api",
    "dev:local": "scripts/dev-local.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --fix --unsafe .",
    "format": "biome format --write .",
    "typecheck": "bun scripts/typecheck.js",
    "typecheck:update": "bun scripts/typecheck.js --update",
    "check:release-notes": "bun scripts/check-release-notes.js",
    "verify": "bun scripts/verify.js",
    "verify:fast": "bun scripts/verify.js --fast",
    "test": "bun test",
    "test:scripts": "bun test ./scripts ./packages/api/scripts",
    "test:e2e": "bun --env-file=.env --bun playwright test",
    "test:e2e:ui": "dotenv -e .env -- playwright test --ui",
    "test:e2e:update-snapshots": "dotenv -e .env -- playwright test --project=mobile-visual --project=desktop-visual --update-snapshots",
    "tsc:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "load:local": "scripts/load/run-local.sh",
    "audit": "fallow-audit",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@imapps/biome-config": "0.5.1",
    "@imapps/dev-scripts": "0.1.0",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/bun": "^1.1.14",
    "@types/node": "^25.8.0",
    "dotenv": "^16",
    "dotenv-cli": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "mongodb": "^7.2.0",
    "semantic-release": "^24.2.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "bun@1.4.2",
  "lint-staged": {
    "*.{ts,tsx,json}": "biome check --fix --unsafe"
  },
  "patchedDependencies": {
    "playwright-core@1.60.0": "patches/playwright-core@1.60.0.patch"
  }
}
